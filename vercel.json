{
  "projectId": "",
  "orgId": "",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "framework": "nextjs",
  "regions": ["fra1"],
  "git": {
    "deploymentEnabled": {
      "main": false,
      "app-section": true,
      "env/app-dd": true
    }
  },
  "env": [
    {
      "key": "NEXT_PUBLIC_SUPABASE_URL",
      "value": "@next_public_supabase_url"
    },
    {
      "key": "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY",
      "value": "@next_public_supabase_publishable_default_key"
    },
    {
      "key": "SUPABASE_SERVICE_ROLE_KEY",
      "value": "@supabase_service_role_key"
    },
    {
      "key": "NEXT_PUBLIC_HOST_URL",
      "value": "@next_public_host_url"
    },
    {
      "key": "CLIENT_ID",
      "value": "@client_id"
    },
    {
      "key": "TENANT_ID",
      "value": "@tenant_id"
    },
    {
      "key": "FINANCE_SECRET",
      "value": "@finance_secret"
    },
    {
      "key": "NEXT_PUBLIC_SSO_URL",
      "value": "@next_public_sso_url"
    },
    {
      "key": "NEXT_PUBLIC_GROUP",
      "value": "@next_public_group"
    },
    {
      "key": "NEXT_PUBLIC_SCHOOL_NAME",
      "value": "@next_public_school_name"
    },
    {
      "key": "ENTRA_TENANT_ID",
      "value": "@entra_tenant_id"
    },
    {
      "key": "ENTRA_CLIENT_ID",
      "value": "@entra_client_id"
    },
    {
      "key": "ENTRA_CLIENT_SECRET",
      "value": "@entra_client_secret"
    },
    {
      "key": "ENTRA_DEFAULT_DOMAIN",
      "value": "@entra_default_domain"
    },
    {
      "key": "STUDENT_GROUP_ID",
      "value": "@student_group_id"
    },
    {
      "key": "COGE_MAIL",
      "value": "@coge_mail"
    },
    {
      "key": "NEXT_PUBLIC_INSTITUT",
      "value": "@next_public_institut"
    }
  ]
}
